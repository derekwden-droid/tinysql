    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
